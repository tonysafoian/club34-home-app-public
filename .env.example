# ─────────────────────────────────────────────────────────────────────────────
# Janus — Example Environment Variables
#
# Copy this file to .env and configure your database and desired integrations.
# All integrations are optional and degrade gracefully if credentials are omitted.
# ─────────────────────────────────────────────────────────────────────────────

# Core Application
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/household_db
ENABLE_CRON=false
PUBLIC_BASE_URL=http://localhost:5000
APP_DOMAIN=example.com

# Household Configuration
ADMIN_EMAIL=admin@example.com
ASSISTANT_EMAIL=assistant@example.com
HOUSEHOLD_DOMAIN=example.com
HOME_LAT=34.0522
HOME_LNG=-118.2437

# Authentication & Test Mode
ENABLE_DEMO_LOGIN=true                         # Enables 1-click test login without Google/Apple OAuth setup
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ── LLM & AI Engine (Janus) ──────────────────────────────────────────────────
# Quickstart: You only need ONE key to start! Get a free Gemini key at https://aistudio.google.com/
GEMINI_API_KEY=                                # Required for text-embedding-004 semantic memory & Gemini (FREE tier available)
OPENROUTER_API_KEY=                            # Optional: Unified router for Claude 3.5 Sonnet, GPT-4o, DeepSeek (https://openrouter.ai/)
OLLAMA_BASE_URL=                               # Optional: 100% Free local AI (e.g. http://localhost:11434)
MODEL_DEFAULT=google/gemini-2.5-flash
MODEL_COMPLEX=google/gemini-2.5-pro

# Specialized AI Workers (Optional)
PERPLEXITY_API_KEY=                            # Live real-time web research (https://www.perplexity.ai/)
FIRECRAWL_API_KEY=                             # Web scraping & manual ingestion (https://www.firecrawl.dev/)
ELEVENLABS_API_KEY=                            # Text-to-speech speaker broadcasts (https://elevenlabs.io/)
FAL_API_KEY=                                   # AI image generation worker (https://fal.ai/)
GOOGLE_MAPS_API_KEY=                           # Commute times & geocoding (https://console.cloud.google.com/)

# Smart Home — Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=                                  # Long-Lived Access Token

# Vehicle Fleet — Tesla
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:5000/api/tesla/callback

# Messaging & Communications
WATI_API_KEY=                              # WhatsApp integration via WATI
WATI_TENANT_ID=
RESEND_API_KEY=                            # Transactional email

# Network Infrastructure (Optional)
FORTIGATE_BASE_URL=
FORTIGATE_API_TOKEN=
RUCKUS_BASE_URL=
RUCKUS_USERNAME=
RUCKUS_PASSWORD=


# Pool & Spa (iAquaLink / Zodiac)
IAQUALINK_API_KEY=
IAQUALINK_USERNAME=
IAQUALINK_PASSWORD=

# Computer Agent / Machine Token
COMPUTER_ADMIN_TOKEN=                      # Shared secret for headless automations
