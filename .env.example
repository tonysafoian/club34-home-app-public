# ─────────────────────────────────────────────────────────────────────────────
# Household OS (Janus) — Example Environment Variables
#
# Copy this file to .env and configure your database and desired integrations.
# All integrations are optional and degrade gracefully if credentials are omitted.
# ─────────────────────────────────────────────────────────────────────────────

# Core Application
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/household_db
ENABLE_CRON=false
PUBLIC_BASE_URL=http://localhost:5000
APP_DOMAIN=example.com

# Household Configuration
ADMIN_EMAIL=admin@example.com
ASSISTANT_EMAIL=assistant@example.com
HOUSEHOLD_DOMAIN=example.com
HOME_LAT=34.0522
HOME_LNG=-118.2437

# Authentication
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# LLM & AI Providers (Janus)
OPENROUTER_API_KEY=
GEMINI_API_KEY=                            # Required for text-embedding-004 semantic memory
PERPLEXITY_API_KEY=                        # Research worker
FIRECRAWL_API_KEY=                         # Web scraping worker
ELEVENLABS_API_KEY=                        # Text-to-speech announcements
MODEL_DEFAULT=google/gemini-2.5-flash
MODEL_COMPLEX=google/gemini-2.5-pro

# Smart Home — Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=                                  # Long-Lived Access Token

# Vehicle Fleet — Tesla
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:5000/api/tesla/callback

# Messaging & Communications
WATI_API_KEY=                              # WhatsApp integration via WATI
WATI_TENANT_ID=
RESEND_API_KEY=                            # Transactional email

# Network Infrastructure (Optional)
FORTIGATE_BASE_URL=
FORTIGATE_API_TOKEN=
RUCKUS_BASE_URL=
RUCKUS_USERNAME=
RUCKUS_PASSWORD=

# Sports & Pickup Basketball Hub (Ball Module)
BALL_LOCATION=Community Recreation Center, Court 1
BALL_TITLE=Weekly Pickup Basketball
HOST_NAME=Organizer Name
HOST_EMAIL=organizer@example.com

# Computer Agent / Machine Token
COMPUTER_ADMIN_TOKEN=                      # Shared secret for headless automations
