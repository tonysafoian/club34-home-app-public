modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0", "github:1.0.0"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
# Production start: apply any pending migrations BEFORE the server boots.
# The runner refuses to run if it detects bootstrap drift (pre-existing
# schema + empty ledger) — see scripts/run-migrations.ts. To bootstrap
# a fresh database, run `npm run migrate:seed` once before deploying.
run = ["sh", "-c", "npm run migrate && node dist/index.js"]
build = ["sh", "-c", "npm run build"]
publicDir = "dist/public"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "server-tests"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm audit --omit=dev 2>&1 || true"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eslint src/ server/ scripts/ supabase/functions/ --ext .ts,.tsx --pass-on-unpruned-suppressions"

[[workflows.workflow]]
name = "server-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/run-server-tests.ts"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5100
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = ""
VITE_SUPABASE_PUBLISHABLE_KEY = ""
VITE_SUPABASE_PROJECT_ID = ""
HA_URL = "http://homeassistant.local:8123"
GOOGLE_CLIENT_ID = ""
GOOGLE_REDIRECT_BASE_URL = "http://localhost:5000"
JANUS_TEST_MODE = "true"
RUCKUS_BASE_URL = ""
RUCKUS_USERNAME = "admin"

[userenv.development]

[objectStorage]
defaultBucketID = ""
